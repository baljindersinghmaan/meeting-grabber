{
  "manifest_version": 3,
  "name": "Meet Caption Grabber",
  "version": "1.2.0",
  "description": "Capture Google Meet / Teams live captions and download an AI-generated summary via Groq's free API (paste your own key).",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://api.groq.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meet Caption Grabber"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["summarizer.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
