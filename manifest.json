{
  "manifest_version": 3,
  "name": "Meet Caption Grabber",
  "version": "1.0.0",
  "description": "Capture Google Meet live captions and export them as a named transcript .txt file.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meet Caption Grabber"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
